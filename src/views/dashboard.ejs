                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="m20 20-3.5-3.5"></path>
                    </svg>
                    <input id="contactSearch" type="text" inputmode="search" role="searchbox" autocomplete="off" placeholder="Search name or phone number" aria-controls="contactsList" />
                    <button class="contacts-search-clear" id="contactsSearchClear" type="button" aria-label="Clear contact search" title="Clear search" hidden>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18"></path>
                      </svg>
                    </button>
                  </label>
                  <span class="contacts-toolbar-note">Search by name, number, or chat ID</span>
                </div>
                <p class="feedback" id="contactsFeedback" role="status" aria-live="polite"></p>
                <div class="contacts-list" id="contactsList">
                  <p class="muted">Open this page to load your contacts.</p>
                </div>
              </div>
            </article>
            </div>

            <div class="method-panel" id="contacts-saved-panel" role="tabpanel" aria-labelledby="contactsTabSaved" hidden>
              <article class="card contacts-card">
                <div class="card-header section-head contacts-header">
                  <div class="contacts-heading">
                    <div class="contacts-heading-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
