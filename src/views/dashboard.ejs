<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    />
    <title>ScheduleBot Dashboard</title>
    <link rel="stylesheet" href="/public/styles.css" />
    <script>
      (function () {
        try {
          var storedTheme = window.localStorage.getItem('schedulebot-theme');
          document.documentElement.setAttribute('data-theme', storedTheme === 'light' ? 'light' : 'dark');
        } catch (error) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();

      (function () {
        if (window.location.hash) {
          document.documentElement.classList.add('has-route-hash');
        }
      })();
    </script>
  </head>
  <body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app" id="top">
      <aside class="sidebar" id="sidebar" aria-label="Dashboard navigation">
        <div class="sidebar-header">
          <span class="brand-mark">S</span>
          <span class="brand-name">ScheduleBot</span>
        </div>

        <div class="sidebar-body">
          <nav class="sidebar-nav">
            <p class="nav-group-label">Workspace</p>
            <a class="nav-item active" href="#account">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4"></circle>
                <path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path>
              </svg>
              <span>Account</span>
            </a>
            <a class="nav-item" href="#profile">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                <circle cx="9" cy="10" r="2.2"></circle>
                <path d="M5.5 16c.6-1.8 2-2.6 3.5-2.6s2.9.8 3.5 2.6"></path>
                <path d="M15 9h4M15 13h4"></path>
              </svg>
              <span>Profile</span>
            </a>

            <p class="nav-group-label nav-group-spaced">Messaging</p>
            <a class="nav-item" href="#send-message">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 2L11 13"></path>
                <path d="M22 2L15 22 11 13 2 9 22 2z"></path>
              </svg>
              <span>Send Message</span>
            </a>
            <a class="nav-item" href="#inbox">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-4l-3 4-4-8-3 4H2"></path>
                <path d="M5.45 5.11A9 9 0 0 1 20 12"></path>
                <path d="M18.55 18.89A9 9 0 0 1 4 12"></path>
              </svg>
              <span>Inbox</span>
            </a>
            <a class="nav-item" href="#contacts">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span>Contacts</span>
            </a>

            <p class="nav-group-label nav-group-spaced">Automation</p>
            <a class="nav-item" href="#schedule">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M3 10h18M8 2v4M16 2v4"></path>
              </svg>
              <span>Schedule</span>
            </a>
            <a class="nav-item" href="#custom-commands">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 17l6-6-6-6"></path>
                <path d="M12 19h8"></path>
              </svg>
              <span>Custom Command</span>
            </a>
            <a class="nav-item" href="#reminders">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                <path d="M10 21h4"></path>
              </svg>
              <span>Reminders</span>
            </a>
            <a class="nav-item" href="#deleted-messages">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                <path d="M10 11v6M14 11v6"></path>
                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
              </svg>
              <span>Deleted Messages</span>
            </a>
            <button class="nav-item nav-item-parent" id="settingsNavToggle" type="button" aria-current="false" aria-expanded="false" aria-controls="settingsNavSubmenu">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.04 2.04-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56v.09h-2.88v-.09A1.7 1.7 0 0 0 10.88 18.6a1.7 1.7 0 0 0-1.88.34l-.06.06-2.04-2.04.06-.06A1.7 1.7 0 0 0 7.3 15a1.7 1.7 0 0 0-1.56-1.03h-.09v-2.88h.09A1.7 1.7 0 0 0 7.3 10.06a1.7 1.7 0 0 0-.34-1.88L6.9 8.12 8.94 6.1l.06.06a1.7 1.7 0 0 0 1.88.34 1.7 1.7 0 0 0 1.03-1.56v-.09h2.88v.09a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.04 2.02-.06.06a1.7 1.7 0 0 0-.34 1.88 1.7 1.7 0 0 0 1.56 1.03h.09v2.88h-.09A1.7 1.7 0 0 0 19.4 15Z"></path>
              </svg>
              <span>Settings</span>
              <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </button>
            <div class="nav-submenu" id="settingsNavSubmenu" aria-hidden="true">
              <a class="nav-subitem" href="#settings" data-settings-section="appearance">Appearance</a>
              <a class="nav-subitem" href="#settings" data-settings-section="permissions">Reply permissions</a>
              <a class="nav-subitem" href="#settings" data-settings-section="security">Security</a>
            </div>
          </nav>
        </div>

        <div class="sidebar-footer">
          <span class="status-indicator <%= waState.ready ? 'is-on' : 'is-off' %>"></span>
          <span class="sidebar-footer-text">WhatsApp <%= waState.ready ? 'connected' : 'offline' %></span>
        </div>
      </aside>

      <main class="main">
        <header class="top-nav">
          <div class="top-nav-inner">
            <button class="icon-btn" id="sidebarMenuBtn" type="button" aria-label="Open menu">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                <path d="M9.5 4v16"></path>
              </svg>
            </button>
            <div class="top-nav-title-wrap">
              <nav class="top-nav-breadcrumb" aria-label="Breadcrumb">
                <span class="crumb" id="breadcrumbRoot">Dashboard</span>
                <span class="crumb-sep">/</span>
                <span class="crumb" id="breadcrumbPage">Account</span>
                <span class="crumb-sep" id="breadcrumbSectionSep" hidden>/</span>
                <span class="crumb is-current" id="breadcrumbSection" hidden></span>
              </nav>
            </div>
            <button class="icon-btn theme-toggle-btn" id="themeToggleBtn" type="button" aria-label="Toggle light/dark mode">
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
              </svg>
              <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </header>

        <div class="container">
          <section class="page" data-page="account" id="account">
            <div class="account-layout">
              <article class="card account-connection-card">
                <div class="account-hero">
                  <div>
                    <p class="account-eyebrow">WhatsApp account</p>
                    <h2 class="account-title">Connection</h2>
                    <p class="account-description">Link the account that sends your scheduled messages.</p>
                  </div>
                  <span class="account-status <%= waState.ready ? 'is-ready' : 'is-waiting' %>" id="wa-status">
                    <span aria-hidden="true"></span><%= waState.status %>
                  </span>
                </div>

                <div class="account-connection-content">
                  <div class="method-tabs account-method-tabs" role="tablist" aria-label="Connection method">
                    <button type="button" class="method-tab active" id="methodTabQr" data-method="qr" role="tab">QR code</button>
                    <button type="button" class="method-tab" id="methodTabPhone" data-method="phone" role="tab" <%= waState.ready ? 'disabled' : '' %>>Phone number</button>
                  </div>

                  <div id="qr-method" class="method-panel">
                    <div id="wa-connected-wrap" class="connected-wrap" <%= waState.ready ? '' : 'hidden' %>>
                      <div class="connected-icon" aria-hidden="true">✓</div>
                      <div class="connected-intro">
                        <p class="connected-title">WhatsApp is connected</p>
                        <p class="connected-subtitle">This account is ready to send scheduled messages.</p>
                      </div>
                      <a class="btn btn-outline btn-sm connected-profile-link" href="#profile">View profile</a>
                    </div>

                    <div id="wa-qr-wrap" class="qr-wrap" <%= !waState.ready && waState.qrCodeDataUrl ? '' : 'hidden' %>>
                      <% if (waState.qrCodeDataUrl) { %>
                      <img src="<%= waState.qrCodeDataUrl %>" alt="QR WhatsApp" class="qr" />
                      <% } else { %>
                      <img src="" alt="QR WhatsApp" class="qr" />
                      <% } %>
                      <div class="qr-copy">
                        <p id="wa-qr-caption" class="qr-caption">Scan this code in WhatsApp to connect the bot.</p>
                        <ol class="qr-instructions">
                          <li>Open WhatsApp Settings and select <strong>Linked Devices</strong>.</li>
                          <li>Choose <strong>Link a Device</strong>, then scan this code.</li>
                        </ol>
                      </div>
                    </div>
                    <p id="wa-qr-empty" class="account-empty-state" <%= !waState.ready && !waState.qrCodeDataUrl ? '' : 'hidden' %>>Waiting for a new QR code. It will appear here automatically.</p>
                  </div>

                  <div id="phone-method" class="method-panel" hidden>
                    <div class="field">
                      <label for="pairingPhone">Phone number</label>
                      <input id="pairingPhone" type="tel" inputmode="numeric" pattern="[+]?[0-9]*" autocomplete="tel" placeholder="60812xxxxxxx" <%= waState.ready ? 'disabled' : '' %> />
                      <p class="hint">Include your country code, without spaces or the + symbol.</p>
                    </div>
                    <button type="button" class="btn btn-primary btn-block" id="requestPairingBtn" <%= waState.ready ? 'disabled' : '' %>>Get pairing code</button>
                    <p id="pairing-feedback" class="feedback"></p>

                    <div id="pairing-code-wrap" class="pairing-code-wrap" hidden>
                      <p class="muted">Your pairing code</p>
                      <p class="pairing-code" id="pairing-code-value"></p>
                      <p class="hint">In WhatsApp, open Linked Devices, choose Link with phone number, and enter this code.</p>
                    </div>
                  </div>

                  <ul class="tips muted" id="account-target-tips" hidden></ul>
                </div>
              </article>

              <aside class="account-side-panel">
                <article class="card profile-preview-card">
                  <div class="profile-preview-avatar" id="accountProfileAvatar" aria-hidden="true">?</div>
                  <div class="profile-preview-info">
                    <p class="profile-preview-label">Signed in as</p>
                    <p class="profile-preview-name" id="accountProfileName"><%= waState.ready ? (waState.connectedAccount?.displayName || '-') : 'Not connected' %></p>
                  </div>
                  <a class="btn btn-outline btn-sm profile-preview-link" href="#profile">View profile</a>
                </article>
                <div class="account-help-note">
                  <span class="account-help-icon" aria-hidden="true">?</span>
                  <p>Connection status refreshes automatically while this page is open.</p>
                </div>
              </aside>
            </div>
          </section>

          <section class="page" data-page="reminders" id="reminders" hidden>
            <div class="grid two-cols">
              <article class="card">
                <div class="card-header section-head">
                  <div>
                    <h2 class="card-title">Create Reminder</h2>
                    <p class="card-description">Send a WhatsApp reminder before a date.</p>
                  </div>
                </div>
                <div class="card-content">
                  <form id="reminder-form">
                    <div class="field">
                      <label for="reminderName">Reminder name</label>
                      <input id="reminderName" required placeholder="Birthday Ahmad" />
                    </div>
                    <div class="grid two-cols">
                      <div class="field">
                        <label for="reminderDate">Date</label>
                        <input id="reminderDate" type="date" required />
                      </div>
                      <div class="field">
                        <label for="reminderTime">Time</label>
                        <input id="reminderTime" type="time" value="09:00" required />
                      </div>
                    </div>
                    <div class="field">
                      <label for="reminderEarlyDays">Early days</label>
                      <input id="reminderEarlyDays" value="10" placeholder="10, 3, 1, 0" required />
                      <p class="hint">Use comma-separated days before the date. Include 0 for the date itself.</p>
                    </div>
                    <div class="field">
                      <label for="reminderTargetChats">Target chats</label>
                      <textarea id="reminderTargetChats" rows="3" required placeholder="60123456789@s.whatsapp.net, 1203630xxxx@g.us"></textarea>
                      <p class="hint">Enter phone numbers or WhatsApp JIDs, separated by commas or new lines. Example: 60123456789 or 1203630xxxx@g.us.</p>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" id="reminderSaveBtn">Save Reminder</button>
                    <p class="feedback" id="reminderFeedback" role="status"></p>
                  </form>
                </div>
              </article>
              <article class="card table-card">
                <div class="card-header section-head">
                  <div>
                    <h2 class="card-title">Reminder List</h2>
                    <p class="card-description">Manage upcoming bot notifications.</p>
                  </div>
                </div>
                <div class="card-content no-pad">
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th>Name</th><th>Date</th><th>Early days</th><th>Targets</th><th></th></tr></thead>
                      <tbody id="reminder-list">
                        <% if (!reminders.length) { %><tr><td colspan="5" class="muted">No reminders yet</td></tr><% } %>
                        <% reminders.forEach((item) => { %>
                        <tr data-reminder-id="<%= item.id %>">
                          <td><strong><%= item.name %></strong><br><span class="muted"><%= item.time %></span></td>
                          <td><%= item.date %></td>
                          <td><%= item.earlyDays.join(', ') %></td>
                          <td><%= item.targetChats.length %> chat(s)</td>
                          <td class="cell-action"><button type="button" class="btn btn-ghost btn-sm reminder-delete-btn" data-id="<%= item.id %>">Delete</button></td>
                        </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </article>
            </div>
          </section>

          <section class="page" data-page="profile" id="profile" hidden>
            <div class="profile-layout">
              <article class="card profile-card">
                <div class="profile-hero">
                  <div class="profile-avatar" id="profileAvatar" aria-hidden="true">?</div>
                  <div class="profile-hero-info">
                    <p class="account-eyebrow">WhatsApp profile</p>
                    <h2 class="account-title" id="profileName"><%= waState.connectedAccount?.displayName || 'Not connected' %></h2>
                    <span class="account-status <%= waState.ready ? 'is-ready' : 'is-waiting' %>" id="profileStatus">
                      <span aria-hidden="true"></span><%= waState.ready ? 'Connected' : 'Not connected' %>
                    </span>
                  </div>
                </div>

                <div class="profile-details" id="profileDetails" <%= waState.ready ? '' : 'hidden' %>>
                  <div class="profile-detail-row">
                    <span class="profile-detail-label">Name</span>
                    <span class="profile-detail-value" id="waConnectedName"><%= waState.connectedAccount?.displayName || '-' %></span>
                  </div>
                  <div class="profile-detail-row">
                    <span class="profile-detail-label">Phone</span>
                    <span class="profile-detail-value" id="waConnectedPhone"><%= waState.connectedAccount?.phoneNumber || '-' %></span>
                  </div>
                  <div class="profile-detail-row">
                    <span class="profile-detail-label">JID</span>
                    <span class="profile-detail-value profile-detail-mono" id="waConnectedJid"><%= waState.connectedAccount?.jid || '-' %></span>
                  </div>
                </div>
                <p class="account-empty-state" id="profileEmptyState" <%= waState.ready ? 'hidden' : '' %>>Connect WhatsApp from the <a href="#account">Account</a> page to see your profile details here.</p>
              </article>
            </div>
          </section>

          <section class="page" data-page="schedule" id="schedule" hidden>
            <div class="method-tabs" id="schedule-tabs" role="tablist" aria-label="Schedule tabs">
              <button type="button" class="method-tab active" id="scheduleTabCreate" data-tab="create" role="tab" aria-controls="schedule-create-panel" aria-selected="true">Create Schedule</button>
              <button type="button" class="method-tab" id="scheduleTabList" data-tab="list" role="tab" aria-controls="schedule-list-panel" aria-selected="false">Schedule List</button>
            </div>

            <div class="method-panel" id="schedule-create-panel" role="tabpanel" aria-labelledby="scheduleTabCreate">
              <article class="card" id="create-schedule">
                <div class="card-header">
                  <h2 class="card-title">Create Schedule</h2>
                  <p class="card-description">Queue a new WhatsApp message</p>
                </div>
                <div class="card-content">
                  <form id="schedule-form">
                    <div class="field">
                      <label for="targetType">Target Type</label>
                      <select id="targetType" name="targetType" required>
                        <option value="group" selected>Group Chat</option>
                        <option value="personal">Personal Chat</option>
                      </select>
                    </div>

                    <div class="field" id="targetValueField">
                      <label for="targetValue" id="targetValueLabel">Group ID (example: 1203630xxxx@g.us)</label>
                      <input id="targetValue" name="targetValue" required />
                      <p class="hint" id="targetHint">You can enter 1203630xxxx only or with @g.us suffix</p>
                    </div>

                    <div class="group-tools" id="groupTools">
                      <div class="group-tools-head">
                        <label for="groupPicker">Select Group From WhatsApp Account</label>
                        <button type="button" class="btn btn-outline btn-sm" id="refreshGroupsBtn">Refresh Groups</button>
                      </div>
                      <select id="groupPicker">
                        <option value="">Loading group list...</option>
                      </select>
                      <p class="hint" id="groupFetchHint">Pick a group to auto-fill the ID.</p>
                    </div>

                    <div class="group-tools" id="personalChatTools" hidden>
                      <div class="group-tools-head">
                        <label for="personalChatPicker">Generate From Current Personal Chats</label>
                        <button type="button" class="btn btn-outline btn-sm" id="refreshPersonalChatsBtn">Refresh Chats</button>
                      </div>
                      <select id="personalChatPicker">
                        <option value="">Loading personal chat list...</option>
                      </select>
                      <p class="hint" id="personalChatFetchHint">Pick a personal chat to auto-fill the destination ID.</p>
                    </div>

                    <div class="field">
                      <label for="message">Message</label>
                      <textarea id="message" name="message" rows="4" required></textarea>
                    </div>

                    <div class="field" id="scheduleButtonsField">
                      <div class="field-head">
                        <label>Interactive Buttons <span class="muted">(optional)</span></label>
                        <button type="button" class="btn btn-outline btn-sm" id="scheduleAddButtonRowBtn">Add Button</button>
                      </div>
                      <div id="scheduleButtonRows" class="button-rows"></div>
                      <p class="hint">User boleh pilih button terus tanpa perlu tulis JSON.</p>
                    </div>

                    <div class="field field-narrow">
                      <label for="scheduleAt">Send Time</label>
                      <input id="scheduleAt" name="scheduleAt" type="datetime-local" required />
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Save Schedule</button>
                  </form>
                  <p id="form-feedback" class="feedback"></p>
                </div>
              </article>
            </div>

            <div class="method-panel" id="schedule-list-panel" role="tabpanel" aria-labelledby="scheduleTabList" hidden>
              <article class="card table-card" id="schedule-list">
                <div class="card-header section-head">
                  <div>
                    <h2 class="card-title">Schedule List</h2>
                    <p class="card-description">Track every pending, sent, and failed job in one clean table.</p>
                  </div>
                </div>
                <div class="card-content no-pad">
                  <div class="table-wrap">
                    <table>
                      <thead>
                        <tr>
                          <th>ID</th>
                          <th>Type</th>
                          <th>Details</th>
                          <th>Status</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!schedules.length) { %>
                        <tr>
                          <td colspan="5" class="muted">No schedules yet</td>
                        </tr>
                        <% } %>

                        <% schedules.forEach((item) => { %>
                        <tr>
                          <td><%= item.id %></td>
                          <td>
                            <span class="badge badge-outline">
                              <%= item.targetType === 'group' ? 'group' : 'personal' %>
                            </span>
                          </td>
                          <td class="schedule-details-cell">
                            <div class="schedule-detail-actions">
                              <button class="btn btn-outline btn-sm btn-view-schedule" data-id="<%= item.id %>">View</button>
                            </div>
                          </td>
                          <td>
                            <span class="badge badge-<%= item.status %>"><%= item.status %></span>
                          </td>
                          <td class="cell-action">
                            <button class="btn btn-ghost btn-sm btn-delete" data-id="<%= item.id %>">Delete</button>
                          </td>
                        </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </article>
            </div>
          </section>

          <section class="page" data-page="send-message" id="send-message" hidden>
            <div class="grid two-cols">
