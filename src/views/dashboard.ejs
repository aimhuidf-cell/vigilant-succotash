                        <label for="commandMediaSource">Media Source</label>
                        <select id="commandMediaSource" name="mediaSource">
                          <option value="url" selected>By URL</option>
                          <option value="upload">Upload File</option>
                        </select>
                      </div>

                      <div class="field" id="commandMediaUrlField">
                        <label for="commandMediaUrl">Media URL <span class="muted">(optional)</span></label>
                        <input id="commandMediaUrl" name="mediaUrl" placeholder="https://..." />
                      </div>

                      <div class="field" id="commandMediaUploadField" hidden>
                        <label for="commandMediaUpload">Upload Media File <span class="muted">(max 20MB)</span></label>
                        <input id="commandMediaUpload" name="mediaUpload" type="file" />
                        <p class="hint" id="commandMediaUploadHint">Choose a file to upload and use as media source.</p>
                      </div>

                      <div class="field" id="commandFileNameField" hidden>
                        <label for="commandFileName">File Name <span class="muted">(document only, optional)</span></label>
                        <input id="commandFileName" name="fileName" placeholder="brochure.pdf" />
                      </div>

                      <div class="field" id="commandResponseField">
                        <label for="commandResponse">Response Text</label>
                        <textarea id="commandResponse" name="response" rows="3" placeholder="Reply message..."></textarea>
                        <p class="hint" id="commandResponseRuleHint">Response text is required when using media and button together.</p>
                      </div>

                      <div class="field" id="commandButtonsField">
                        <div class="field-head">
                          <label>Buttons <span class="muted">(optional)</span></label>
                          <button type="button" class="btn btn-outline btn-sm" id="addButtonRowBtn">Add Button</button>
                        </div>
                        <div id="buttonRows" class="button-rows"></div>
                        <p class="hint">Add interactive buttons to your response. Open the setup guide for button value rules and examples.</p>
                      </div>

                      <div class="field-row optional-meta-row" id="commandOptionalMetaRow">
                        <div class="field">
                          <label for="commandCategory">Category <span class="muted">(optional)</span></label>
                          <select id="commandCategory" name="category">
                            <% commandCategories.forEach((cat) => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                            <% }) %>
                          </select>
                        </div>
                        <div class="field">
                          <label for="commandDescription">Description <span class="muted">(optional)</span></label>
                          <input id="commandDescription" name="description" placeholder="Short note about this command" />
                        </div>
                      </div>
                    </div>

                    <div class="form-actions">
                      <button type="submit" class="btn btn-block btn-save-command" id="commandSubmitBtn" disabled>Save Command</button>
                      <button type="button" class="btn btn-outline btn-block" id="commandCancelBtn" hidden>Cancel Edit</button>
                    </div>
                  </form>
                  <p id="command-feedback" class="feedback"></p>
                </div>
              </article>
            </div>

            <div class="method-panel" id="command-list-panel" role="tabpanel" aria-labelledby="commandTabList" hidden>
              <article class="card command-list-card built-in-command-card">
                <div class="card-header section-head command-list-header">
                  <div class="contacts-heading">
                    <div class="contacts-heading-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 5h16M4 12h16M4 19h10"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="account-eyebrow">Bot commands</p>
                      <h2 class="card-title">Built-in Commands</h2>
                      <p class="card-description">Commands included in the bot and ready to use.</p>
                    </div>
                  </div>
                  <span class="contacts-count"><%= builtInCommands.length %> commands</span>
                </div>
                <div class="card-content">
                  <div class="command-list-grid built-in-command-grid">
                    <% builtInCommands.forEach((item) => { %>
                    <div class="command-card built-in-command-item">
                      <div class="command-card-top">
                        <code class="command-card-trigger"><%= item.trigger %></code>
                        <span class="badge badge-outline command-card-category"><%= item.category %></span>
                      </div>
                      <p class="command-card-description"><%= item.description %></p>
                    </div>
                    <% }) %>
                  </div>
                </div>
              </article>

              <article class="card command-list-card">
                <div class="card-header section-head command-list-header">
                  <div class="contacts-heading">
                    <div class="contacts-heading-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                      </svg>
                    </div>
                    <div>
                      <p class="account-eyebrow">Auto-reply</p>
                      <h2 class="card-title">Command List</h2>
                      <p class="card-description">All active auto-reply triggers</p>
                    </div>
                  </div>
                  <span class="contacts-count" id="commandListCount"><%= customCommands.length %> command<%= customCommands.length === 1 ? '' : 's' %></span>
                </div>
                <div class="card-content">
                  <div class="command-list-toolbar">
                    <label class="contacts-search command-list-search">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                      <input type="search" id="commandListSearch" placeholder="Search by trigger, description, or category" />
                      <button type="button" class="contacts-search-clear" id="commandListSearchClear" hidden aria-label="Clear search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </button>
                    </label>
                    <select id="commandListCategoryFilter" class="command-list-category-filter">
                      <option value="">All categories</option>
                      <% commandCategories.forEach((cat) => { %>
                      <option value="<%= cat %>"><%= cat %></option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="command-list-grid" id="commandListGrid">
                    <% customCommands.forEach((item) => {
                      const buttonCount = Array.isArray(item.buttons) ? item.buttons.length : 0;
                      const hasMedia = Boolean(item.mediaType && item.mediaUrl);
                      const searchValue = `${item.trigger || ''} ${item.description || ''} ${item.category || ''}`.toLowerCase();
                    %>
                    <div class="command-card" data-trigger="<%= item.trigger %>" data-category="<%= item.category %>" data-search="<%= searchValue %>">
                      <div class="command-card-top">
                        <code class="command-card-trigger"><%= item.trigger %></code>
                        <span class="badge badge-outline command-card-category"><%= item.category %></span>
                      </div>
                      <p class="command-card-description"><%= item.description || 'No description' %></p>
                      <div class="command-card-meta">
                        <span class="command-card-chip"><%= hasMedia ? `Media: ${item.mediaType}` : 'Media: none' %></span>
                        <% if (buttonCount) { %>
                        <span class="command-card-chip">Buttons: <%= buttonCount %></span>
                        <% } %>
                      </div>
                      <div class="command-card-actions">
                        <button class="btn btn-outline btn-sm btn-preview-command" data-trigger="<%= item.trigger %>" aria-label="View command content">View</button>
                        <button class="btn btn-ghost btn-sm btn-edit-command" data-trigger="<%= item.trigger %>">Edit</button>
                        <button class="btn btn-ghost btn-sm btn-delete-command" data-trigger="<%= item.trigger %>">Delete</button>
                      </div>
                    </div>
                    <% }) %>
                  </div>

                  <p class="muted command-list-empty" id="commandListEmpty" <%= customCommands.length ? 'hidden' : '' %>>No custom commands yet</p>
                  <p class="muted command-list-empty" id="commandListNoResults" hidden>No commands match your search.</p>
                </div>
              </article>
            </div>
          </section>

          <section class="page" data-page="deleted-messages" id="deleted-messages" hidden>
            <article class="card">
              <div class="card-header section-head">
                <div>
                  <h2 class="card-title">Deleted Messages</h2>
                  <p class="card-description">List chat names, then open a WhatsApp-style conversation to view deleted messages</p>
                </div>
                <% const deletedMessagesUi = deletedMessages.filter((item) => {
                  const chatId = String(item.chatId || '').toLowerCase();
                  const senderId = String(item.senderId || '').toLowerCase();
                  return !chatId.endsWith('@lid') && !senderId.endsWith('@lid');
                }); %>
                <button type="button" class="btn btn-outline btn-sm" id="clearDeletedMessagesBtn" <%= !deletedMessagesUi.length ? 'disabled' : '' %>>Clear All</button>
              </div>
              <div class="card-content">
                <% const deletedConversationMap = new Map(); %>
                <% deletedMessagesUi.forEach((item) => {
                  const key = String(item.chatId || 'unknown');
                  const chatLabel = item.isGroup
                    ? String(item.chatName || item.chatId || 'Unknown Group')
                    : String(item.senderName || item.chatName || item.chatId || 'Unknown Contact');
                  const existing = deletedConversationMap.get(key);
                  if (!existing) {
                    deletedConversationMap.set(key, {
                      chatId: key,
                      chatLabel,
                      isGroup: Boolean(item.isGroup),
                      total: 1,
                      latest: item,
                    });
                  } else {
                    existing.total += 1;
                    if (new Date(item.deletedAt).getTime() > new Date(existing.latest.deletedAt).getTime()) {
                      existing.latest = item;
                    }
                  }
                }); %>
                <% const deletedConversations = Array.from(deletedConversationMap.values())
                  .sort((a, b) => new Date(b.latest.deletedAt).getTime() - new Date(a.latest.deletedAt).getTime()); %>

                <% if (!deletedConversations.length) { %>
                <p class="muted">No deleted messages recorded yet</p>
                <% } else { %>
                <div class="deleted-conversation-list" id="deletedConversationList">
                  <% deletedConversations.forEach((entry) => {
                    const latest = entry.latest;
                    const latestPreview = latest.mediaUrl
                      ? (latest.fileName || '[' + String(latest.type || 'media') + ']')
                      : (latest.text || '[No content]');
                  %>
                  <article class="deleted-conversation-item">
                    <div class="deleted-conversation-avatar" aria-hidden="true"><%= String(entry.chatLabel || '?').trim().charAt(0).toUpperCase() || '?' %></div>
                    <div class="deleted-conversation-main">
                      <div class="deleted-conversation-top-row">
                        <p class="deleted-conversation-name"><%= entry.chatLabel %></p>
                      </div>
                      <p class="deleted-conversation-preview"><%= latestPreview %></p>
                    </div>
                    <div class="deleted-conversation-actions">
                      <div class="deleted-conversation-action-row">
                        <button
                          type="button"
                          class="btn btn-outline btn-sm deleted-icon-btn btn-open-deleted-conversation"
                          data-chat-id="<%= entry.chatId %>"
                          aria-label="View conversation"
                          title="View conversation"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="btn btn-outline btn-sm deleted-icon-btn deleted-icon-btn-danger btn-delete-deleted-conversation"
                          data-chat-id="<%= entry.chatId %>"
                          aria-label="Delete conversation records"
                          title="Delete conversation records"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                            <path d="M10 11v6M14 11v6"></path>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                          </svg>
                        </button>
                      </div>
                      <time class="deleted-conversation-time deleted-conversation-time-side js-local-datetime" data-iso="<%= latest.deletedAt %>">
                        <%= dayjs(latest.deletedAt).format('DD MMM YYYY HH:mm:ss') %>
                      </time>
                    </div>
                  </article>
                  <% }) %>
                </div>
                <% } %>
              </div>
            </article>
          </section>

          <section class="page" data-page="settings" id="settings" hidden>
            <div class="grid two-cols settings-grid">
              <article class="card" id="settings-appearance">
                <div class="card-header">
                  <h2 class="card-title">Appearance</h2>
                  <p class="card-description">Choose how ScheduleBot looks on this device</p>
                </div>
                <div class="card-content">
                  <div class="field">
                    <label>Theme</label>
                    <div class="theme-choice-group" role="radiogroup" aria-label="Theme">
                      <label class="theme-choice">
                        <input type="radio" name="dashboardTheme" value="light" />
                        <span>Light</span>
                      </label>
                      <label class="theme-choice">
                        <input type="radio" name="dashboardTheme" value="dark" />
                        <span>Dark</span>
                      </label>
                    </div>
                  </div>
                </div>
              </article>

              <article class="card" id="settings-permissions">
                <div class="card-header">
                  <h2 class="card-title">Reply permissions</h2>
                  <p class="card-description">Control who can trigger the bot's automatic replies</p>
                </div>
                <div class="card-content">
                  <div class="field">
                    <label for="botPermissionMode">Respond to</label>
                    <select id="botPermissionMode">
                      <option value="everyone" <%= botPermission.mode === 'everyone' ? 'selected' : '' %>>Everyone</option>
                      <option value="admins" <%= botPermission.mode === 'admins' ? 'selected' : '' %>>Group admins only</option>
                      <option value="owner" <%= botPermission.mode === 'owner' ? 'selected' : '' %>>Owner only</option>
                      <option value="off" <%= botPermission.mode === 'off' ? 'selected' : '' %>>No one (disabled)</option>
                    </select>
                    <p class="hint" id="botPermissionHint">In admin mode, personal chats still receive replies.</p>
                  </div>
                  <p id="botPermissionFeedback" class="feedback" role="status"></p>
                </div>
              </article>

              <article class="card">
                <div class="card-header">
                  <h2 class="card-title">Session</h2>
                  <p class="card-description">End access to this dashboard on this device</p>
                </div>
                <div class="card-content">
                  <form action="/sign-out" method="post">
                    <button class="btn btn-outline" type="submit">Sign out</button>
                  </form>
                </div>
              </article>

              <article class="card" id="settings-security">
                <div class="card-header">
                  <h2 class="card-title">Change password</h2>
                  <p class="card-description">Update the password used to sign in to this dashboard</p>
                </div>
                <div class="card-content">
                  <form class="stack-form" action="/change-password" method="post">
                    <div class="field">
                      <label for="currentPassword">Current password</label>
                      <div class="password-input-wrap">
                        <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />
                        <button class="password-toggle" type="button" aria-label="Show password" aria-controls="currentPassword" aria-pressed="false" data-password-toggle></button>
                      </div>
                    </div>
                    <div class="field">
                      <label for="newPassword">New password</label>
                      <div class="password-input-wrap">
                        <input id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" required />
                        <button class="password-toggle" type="button" aria-label="Show password" aria-controls="newPassword" aria-pressed="false" data-password-toggle></button>
                      </div>
                    </div>
                    <div class="field">
                      <label for="confirmPassword">Confirm new password</label>
                      <div class="password-input-wrap">
                        <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required />
                        <button class="password-toggle" type="button" aria-label="Show password" aria-controls="confirmPassword" aria-pressed="false" data-password-toggle></button>
                      </div>
                    </div>
                    <% if (passwordFeedback) { %>
                    <p class="feedback <%= passwordFeedback.type === 'error' ? 'is-error' : 'is-success' %>" role="status"><%= passwordFeedback.message %></p>
                    <% } %>
                    <button class="btn btn-primary" type="submit">Change password</button>
                  </form>
                </div>
              </article>
            </div>
          </section>
        </div>
      </main>
    </div>

