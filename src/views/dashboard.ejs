                </div>
                <div class="card-content inbox-thread-content">
                  <div class="inbox-message-list" id="inboxMessageList">
                    <p class="muted">Messages will appear here.</p>
                  </div>
                </div>
              </article>
            </div>
          </section>

          <section class="page" data-page="contacts" id="contacts" hidden>
