                  <div class="saved-contact-form" id="savedContactForm" hidden>
                    <input type="hidden" id="savedContactId" value="" />
                    <div class="field-row">
                      <div class="field">
                        <label for="savedContactName">Name</label>
                        <input id="savedContactName" placeholder="e.g. Ali Ahmad" />
