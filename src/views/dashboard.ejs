                </div>
                <div class="card-content">
                  <p class="feedback" id="inboxFeedback"></p>
                  <div class="inbox-conversation-list" id="inboxConversationList">
                    <p class="muted">No conversations loaded yet.</p>
                  </div>
                </div>
              </article>

              <article class="card inbox-thread-card">
                <div class="card-header">
                  <h2 class="card-title" id="inboxThreadTitle">Select a conversation</h2>
