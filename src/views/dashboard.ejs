          <header class="wa-chat-header">
            <span class="wa-back-icon" aria-hidden="true">&#x2039;</span>
            <div class="wa-preview-avatar" id="deletedConversationModalAvatar">D</div>
            <div class="wa-preview-meta">
              <p class="wa-preview-name" id="deletedConversationModalTitle">Deleted Conversation</p>
              <p class="wa-preview-status" id="deletedConversationModalSubtitle">Showing deleted message records</p>
            </div>
            <div class="wa-header-actions" aria-hidden="true">
              <span>&#128269;</span>
              <span>&#128206;</span>
              <span>&#8942;</span>
            </div>
          </header>

          <div class="wa-chat-window deleted-wa-window">
            <div class="wa-chat-conversation" id="deletedConversationModalMessages"></div>
            <div class="wa-composer" aria-hidden="true">
              <div class="wa-composer-icon">&#9786;</div>
              <div class="wa-composer-input">Deleted messages are read-only</div>
              <div class="wa-composer-icon">&#128206;</div>
              <button type="button" class="wa-composer-send" id="deletedConversationModalCloseBtn">Close</button>
            </div>
          </div>
        </article>
      </div>
    </div>

    <script>
      window.__SCHEDULES__ = <%- JSON.stringify(schedules) %>;
      window.__CUSTOM_COMMANDS__ = <%- JSON.stringify(customCommands) %>;
      window.__DELETED_MESSAGES__ = <%- JSON.stringify(deletedMessagesUi) %>;
      window.__SAVED_CONTACTS__ = <%- JSON.stringify(savedContacts) %>;
      window.__REMINDERS__ = <%- JSON.stringify(reminders) %>;
    </script>
    <script src="/public/app.js"></script>
  </body>
</html>
