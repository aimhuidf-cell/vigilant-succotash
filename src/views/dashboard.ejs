                        <line x1="19" y1="8" x2="19" y2="14"></line>
                        <line x1="22" y1="11" x2="16" y2="11"></line>
                      </svg>
                    </div>
                    <div>
                      <div class="contacts-title-row">
                        <p class="account-eyebrow">Manual directory</p>
                        <span class="contacts-count" id="savedContactsCount"><%= savedContacts.length %> contact<%= savedContacts.length === 1 ? '' : 's' %></span>
                      </div>
                      <h2 class="card-title">Saved Contacts</h2>
                      <p class="card-description">Add and manage your own contact list, searchable with the .contact bot command</p>
                    </div>
                  </div>
                  <button type="button" class="btn btn-primary btn-sm" id="savedContactAddBtn">Add Contact</button>
                </div>
                <div class="card-content">
                  <div class="contacts-toolbar">
                    <label class="contacts-search" for="savedContactSearch">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-3.5-3.5"></path>
                      </svg>
                      <input id="savedContactSearch" type="text" inputmode="search" role="searchbox" autocomplete="off" placeholder="Search name, phone, category, or note" aria-controls="savedContactsList" />
                      <button class="contacts-search-clear" id="savedContactSearchClear" type="button" aria-label="Clear contact search" title="Clear search" hidden>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                          <path d="M6 6l12 12M18 6 6 18"></path>
                        </svg>
                      </button>
                    </label>
                    <span class="contacts-toolbar-note">Use .contact &lt;name&gt; from WhatsApp to look up a saved contact</span>
