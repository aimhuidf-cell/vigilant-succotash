                          <option value="<%= cat %>"><%= cat %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="field">
                        <label for="savedContactNote">Note <span class="muted">(optional)</span></label>
                        <input id="savedContactNote" placeholder="Short note" />
                      </div>
                    </div>
                    <div class="form-actions">
                      <button type="button" class="btn btn-primary" id="savedContactSaveBtn">Save Contact</button>
                      <button type="button" class="btn btn-outline" id="savedContactCancelBtn">Cancel</button>
                    </div>
                    <p class="feedback" id="savedContactFormFeedback"></p>
                  </div>

                  <p class="feedback" id="savedContactsFeedback" role="status" aria-live="polite"></p>
                  <div class="contacts-list" id="savedContactsList"></div>
                </div>
              </article>
